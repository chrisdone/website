#!/usr/bin/env hell

-- Dependencies:
--
-- hell-2026-04-28
-- pandoc-3.1.11.1

data Post = Post
  { post :: Text,
    date :: Day,
    title :: Text,
    markdown :: Text,
    html :: Text,
    micro :: Bool
  }

data RssPost = RssPost
  { post :: Text,
    dateRFC2822 :: Text,
    title :: Text,
    html :: Text
  }

-- Main entry point just generates the complete blog every time.
--
--
main = Main.generate

-- The posts are listed under ./posts in this format:
--
-- dijkstra-haskell-java.markdown
-- reasoning-violently.md
-- god-mode.markdown
-- emacs-mail.markdown
--
-- .md or .markdown files, the extension doesn't matter.
--
generate = do
  Process.runProcess_ $ Process.proc "pandoc" ["--version"]
  posts <- Main.generatePosts
  Main.generateArchive posts
  Main.generateRSS posts

-- Write out posts/$post/index.html per $post.
--
generatePosts = do
  posts <- Directory.listDirectory "posts"
  Text.putStrLn $ Text.concat ["Generating ", Show.show (List.length posts), " posts ..."]
  Async.pooledForConcurrently posts \post -> do
    markdown <- Text.readFile $ Text.concat ["posts/", post]
    Maybe.maybe
      (Error.error "Couldn't parse the article!")
      ( \(date, title, micro, remainder) -> do
          html <- Main.render post markdown
          let p = Main.Post {post, date, title, html, markdown, micro}
          p <- Main.renderMicros p remainder
          Monad.return p
      )
      $ Main.parse markdown

-- Generate the /posts/ page.
--
generateArchive = \posts0 -> do
  Text.putStrLn "Generating archive ..."
  let year = (\(y, _m, _d) -> y) . Day.toGregorian . Record.get @"date" @Day
  let years =
        List.groupBy (\x y -> Eq.eq (year x) (year y)) $
          List.reverse $
            List.sortOn
              (Record.get @"date" @Day)
              posts0
  let rows = \posts ->
        Text.concat
          $ List.map
            ( \post ->
                Text.concat
                  [ "<tr><td><a href='",
                    Main.filename (Record.get @"post" post),
                    "/'>",
                    Main.strip (Record.get @"title" post),
                    "</td><td class='date'>",
                    Day.iso8601Show (Record.get @"date" post),
                    "</td></tr>"
                  ]
            )
          $ List.reverse
          $ List.sortOn (Record.get @"date" @Day)
          $ posts
  let tablesByYear =
        List.map
          ( \(i, posts) -> do
              let yr = Text.concat $ List.take 1 $ List.map (Show.show . year) posts
              let nth = if Eq.eq 0 i then "" else "year-latter"
              Text.concat
                [ "<tr><td colspan=2 class='year-heading " <> nth <> "'>" <> yr <> "</td></tr>",
                  rows posts
                ]
          )
          ( List.zip
              (List.iterate' (Int.plus 1) 0)
              years
          )
  let table =
        Text.concat
          [ "---\n",
            "title: Archive\n",
            "---\n",
            "<table id='archive' style='line-height:2em'>",
            Text.concat tablesByYear,
            "</table>"
          ]
  (out, err) <-
    Text.readProcess_ $
      Text.setStdin table $
        Process.proc "pandoc" ["--standalone", "--template", "templates/posts.html"]
  Text.writeFile "webroot/posts/index.html" out

-- Contents of an article looks like this:
--
-- ---
-- date: 2011-04-10
-- title: ‘amb’ operator and the list monad
-- micro: true
-- ---
--
-- We're only interested in the date and the title. The rest is
-- redundant.
--
parse = \article -> do
  sansPrefix <- Text.stripPrefix "---" article
  let (preamble, rest0) = Text.breakOn "---" sansPrefix
  let rest = Text.drop 3 rest0
  let lines = Text.splitOn "\n" preamble
  let pairs =
        List.map
          ( \line -> do
              let (key, value) = Text.breakOn ":" line
              (key, Text.strip (Text.drop 1 value))
          )
          lines
  date0 <- List.lookup "date" pairs
  date <- Day.iso8601ParseM date0
  title <- List.lookup "title" pairs
  let micro = List.lookup "micro" pairs
  Monad.return (date, title, Eq.eq micro (Maybe.Just "true"), rest)

parseMicro = \article -> do
  sansPrefix <- Text.stripPrefix "---" $ Text.strip article
  let (preamble, rest0) = Text.breakOn "---" sansPrefix
  let rest = Text.drop 3 rest0
  let lines = Text.splitOn "\n" preamble
  let pairs =
        List.map
          ( \line -> do
              let (key, value) = Text.breakOn ":" line
              (key, Text.strip (Text.drop 1 value))
          )
          lines
  date0 <- List.lookup "date" pairs
  date <- Day.iso8601ParseM date0
  Monad.return (date, rest)

-- A post consists of a date, title and markdown.
--
-- Rendering them is easy, just run pandoc and apply an HTML template.
render = \post markdown -> do
  let targetDir =
        Text.concat ["webroot/posts/", Main.filename post]
  let targetFile = Text.concat [targetDir, "/index.html"]
  (out, err) <- Text.readProcess_ $ Text.setStdin markdown $
      Process.proc "pandoc" ["--standalone", "--template", "templates/post.html"]
  Directory.createDirectoryIfMissing Bool.True targetDir
  Text.writeFile targetFile out
  Monad.return out

-- An entry of a microblog consists of a date.
--
-- Rendering them is easy, just run pandoc and apply an HTML template,
-- put it in a directory under the parent post's name.
renderMicros = \p remainder -> do
  let entries = List.drop 1 $ Text.splitOn "" remainder
  if Eq.eq (List.length entries) 1
     then IO.pure p
     else do
       let parsed = List.map (\(day,y) -> day) $
             Maybe.mapMaybe Main.parseMicro entries
       let prev = \d -> Maybe.listToMaybe $ List.takeWhile (Ord.lt d) parsed
       let next = \d -> Maybe.listToMaybe $
              List.dropWhile (\x -> List.or [Ord.lt x d, Eq.eq d x]) parsed
       es <- Async.pooledForConcurrently entries \entry -> do
         case Main.parseMicro entry of
           Maybe.Nothing ->
             Error.error $ "Bad parse of entry from " <> Record.get @"post" p
           Maybe.Just micro -> do
             let (day, rest) = micro
             let suburl = "/posts/" <> Main.filenameMicro (Record.get @"post" p) day
             Main.renderMicro p day rest (prev day) (next day)
             IO.pure $
               "\n\n<h1><a href='" <> suburl <> "'>"
                <> Day.iso8601Show day <> "</a></h1>\n\n" <> rest
       let preamble = Text.concat $ List.take 1 $
             Text.splitOn "" $ Record.get @"markdown" p
       let markdown = preamble <>
             Text.unlines es
       html <- Main.render (Record.get @"post" p) markdown
       IO.pure $
         Record.set @"html" @Text html $
         Record.set @"markdown" @Text markdown $
         p

-- A post consists of a date.
--
-- Rendering them is easy, just run pandoc and apply an HTML template.
renderMicro = \p day content mprev mnext -> do
  let post = (Record.get @"post" p)
  let targetDir =
        Text.concat ["webroot/posts/", Main.filenameMicro post day]
  Text.putStrLn $ "Rendering " <> targetDir <> " ..."
  let targetFile = Text.concat [targetDir, "/index.html"]
  let title = Record.get @"title" p
  let url = "/posts/" <> Main.filename post
  let props = [ ("date", Day.iso8601Show day)
              , ("title", title)
              , ("url", url)
              ]
  let preamble = Text.unlines [
        "---",
        Text.unlines (List.map (\(k,v) -> k <> ": " <> v) props),
        "---"
        ]
  (out, err) <- Text.readProcess_ $ Text.setStdin (preamble <> content) $
     Process.proc "pandoc" ["--standalone", "--template", "templates/micro.html"]
  Directory.createDirectoryIfMissing Bool.True targetDir
  Text.writeFile targetFile out

-- Filename stripped of .md/.markdown.
filename = \post -> Text.replace ".md" "" (Text.replace ".markdown" "" post)

-- Filename stripped of .md/.markdown.
filenameMicro = \post day ->
  Text.replace ".md" "" (Text.replace ".markdown" "" post) <>
   "/" <> Day.iso8601Show day

-- Strip out quotes from "foo".
strip = \title ->
  Maybe.maybe title Function.id do
    title' <- Text.stripPrefix "\"" title
    Text.stripSuffix "\"" title'

-- Generate the /rss.xml page.
--
generateRSS = \posts0 -> do
  let posts1 = List.reverse $ List.sortOn (Record.get @"date" @Day) posts0
  posts <- Async.pooledForConcurrently posts1 \p -> do
    date' <-
      Text.readProcessStdout_ $
        Text.setStdin (Day.iso8601Show $ Record.get @"date" @Day p) $
          Process.proc "date" ["-R", "-f", "/dev/stdin"]
    Monad.return $ Main.RssPost { post = Record.get @"post" p,
                                  dateRFC2822 = date',
                                  title = Record.get @"title" p,
                                  html = Record.get @"html" p}
  Text.putStrLn "Generating rss.xml ..."
  let items =
        Text.unlines $
          List.map
            ( \p -> do
                let post = Record.get @"post" p
                let title = Record.get @"title" p
                let dateRFC2822 = Record.get @"dateRFC2822" p
                let content = Record.get @"html" p
                Text.concat
                  [ "<item>",
                    "<title><![CDATA[",
                    Main.strip title,
                    "]]></title>",
                    "<link>https://chrisdone.com/posts/",
                    Main.filename post,
                    "</link>",
                    "<guid>https://chrisdone.com/posts/",
                    Main.filename post,
                    "</guid>",
                    "<description><![CDATA[",
                    content,
                    "]]></description>",
                    "<pubDate>",
                    dateRFC2822,
                    "</pubDate>",
                    "<dc:creator>Chris Done</dc:creator>",
                    "</item>"
                  ]
            )
            posts
  let xml =
        Text.unlines
          [ "<?xml version=\"1.0\" encoding=\"utf-8\"?>",
            "<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\">",
            "<channel>",
            "<title>Chris Done's Blog</title>",
            "<link>https://chrisdone.com</link>",
            "<description><![CDATA[Blog all about programming, especially in Haskell since 2008!]]></description>",
            "<atom:link href=\"https://chrisdone.com/rss.xml\" rel=\"self\" type=\"application/rss+xml\" />",
            "<lastBuildDate>Wed, 22 Dec 2021 00:00:00 UT</lastBuildDate>",
            items,
            "</channel>",
            "</rss>"
          ]
  Text.writeFile "webroot/rss.xml" xml
